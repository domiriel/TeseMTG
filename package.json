{
  "name": "mtg-vis",
  "private": true,
  "type": "module",
  "description": "Dev tooling only (tests/benchmarks). The app itself needs no install: serve the repo root over HTTP.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/e2e/app.e2e.mjs tests/e2e/linking.e2e.mjs",
    "bench": "node bench/pipeline.mjs",
    "bench:browser": "node bench/browser.mjs",
    "serve": "python3 -m http.server 8000",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "playwright": "1.48.2"
  }
}
